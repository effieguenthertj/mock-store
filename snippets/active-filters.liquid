{% assign active_filters = false %}

<div class="p-2 flex items-center">
  {%- for filter in collection.filters -%}
    {%- if filter.type == "price_range" -%}
      {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
        {% assign active_filters = true %}
        <p class="py-2 px-4 rounded-full mb-2 border-2 mr-2">
          <a href="{{ filter.url_to_remove }}">
            {%- assign min_value = filter.min_value.value | default: 0 -%}
            {%- assign max_value = filter.max_value.value | default: filter.range_max -%}
            {{ min_value | money }} - {{ max_value | money }} <span class="ml-2">x</span>
          </a>
        </p>
      {%- endif -%}
    {%- else -%}
      {% if filter.active_values != blank %}
        {% assign active_filters = true %}
      {% endif %}
      {%- for filter_value in filter.active_values -%}
        <p class="py-2 px-4 rounded-full mb-2 border-2 mr-2">
          <a href="{{ filter_value.url_to_remove }}" class="">
            {{ filter_value.label }} <span class="ml-2">x</span>
          </a>
        </p>
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {% if active_filters %}
    <p class="mb-2">
      <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="bg-azure text-lapisLazuli py-3 px-6 rounded-full">Clear all</a>
    </p>
  {% endif %}
</div>